<?xml version="1.0" encoding="utf-8"?><Dashboard CurrencyCulture="chr-US"><Title Text="采购分析(供应商×产品)" Alignment="Left" /><DataSources><SqlDataSource Name="Purchase" ComponentName="sqlDataSource1"><Connection Name="connection" ProviderKey="Postgres"><Parameters><Parameter Name="server" Value="localhost" /><Parameter Name="database" Value="BusinessIntelligence" /><Parameter Name="read only" Value="1" /><Parameter Name="Port" Value="5432" /></Parameters></Connection><Query Type="CustomSqlQuery" Name="采购分析明细"><Sql>select s.name as supplier_name,
 p.part_name as part_name,
 p.part_number as part_number,
 r.amount as amount,
 r.ordered_quantity as qty,
 r.order_date::date as order_date
from bi.purchase_order_row r
join bi.purchase_order po on po.id = r.purchase_order_id and po.company_id = r.company_id
join bi.supplier s on s.id = po.supplier_id and s.company_id = po.company_id
left join bi.part p on p.id = r.part_id and p.company_id = r.company_id
where r.order_date is not null</Sql></Query></SqlDataSource></DataSources><Items><TabContainer ComponentName="tabContainerDashboardItem1" Name="页签"><Pages><Page ComponentName="dashboardTabPage1" Name="供应商→产品排行" ShowItemAsTabPage="false" /><Page ComponentName="dashboardTabPage2" Name="产品→供应商排行" ShowItemAsTabPage="false" /></Pages></TabContainer><DateFilter ComponentName="dateFilterDashboardItem1" Name="时间筛选" DataSource="sqlDataSource1" DataMember="采购分析明细" ParentContainer="dashboardTabPage1" ArrangementMode="Vertical"><DataItems><Dimension DataMember="order_date" Name="采购日期" DateTimeGroupInterval="DayMonthYear" DefaultId="T1" /></DataItems><Dimension DefaultId="T1" /><DateTimePeriods><DateTimePeriod Name="本年"><StartLimit><FlowDateTimePeriodLimit /></StartLimit><EndLimit><FlowDateTimePeriodLimit Offset="1" /></EndLimit></DateTimePeriod><DateTimePeriod Name="去年"><StartLimit><FlowDateTimePeriodLimit /></StartLimit><EndLimit><FlowDateTimePeriodLimit Offset="-1" /></EndLimit></DateTimePeriod><DateTimePeriod Name="本月"><StartLimit><FlowDateTimePeriodLimit Interval="Month" /></StartLimit><EndLimit><FlowDateTimePeriodLimit Interval="Month" Offset="1" /></EndLimit></DateTimePeriod><DateTimePeriod Name="最近 12 个月"><StartLimit><FlowDateTimePeriodLimit Interval="Month" Offset="-12" /></StartLimit><EndLimit><FlowDateTimePeriodLimit Interval="Month" /></EndLimit></DateTimePeriod></DateTimePeriods></DateFilter><Grid ComponentName="gridSupplier" Name="供应商汇总(点击穿透)" DataSource="sqlDataSource1" DataMember="采购分析明细" ParentContainer="dashboardTabPage1"><InteractivityOptions MasterFilterMode="Multiple" /><DataItems><Dimension DataMember="supplier_name" Name="供应商" DefaultId="S1" SortOrder="Descending" SortByMeasure="S2" /><Measure DataMember="amount" Name="采购金额(¥)" SummaryType="Sum" DefaultId="S2"><NumericFormat FormatType="Number" Precision="0" Unit="Ones" IncludeGroupSeparator="true" /></Measure><Measure DataMember="qty" Name="采购数量" SummaryType="Sum" DefaultId="S3"><NumericFormat FormatType=