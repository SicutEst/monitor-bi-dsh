# Monitor BI 连接配置模板 —— 复制为 bi_config.env 并按实际环境填写
# 必填四项(BI_COMPANY 公司号必须带 .1 后缀,如 002.1)
BI_URL=https://localhost:433
BI_COMPANY=002.1
BI_USER=admin
BI_PASSWORD=改成实际密码

# 可选:BI 服务器日志目录(verify 命令查取数/报错用;BI 不在本机时整段删掉)
# BI_LOG_DIR=C:\Program Files\Monitor ERP System AB\MONITOR BI Server\Logs

# 可选:直连 BI 库导出原始 XML 定义(get-xml / check_bindings 用;需本机有 psql 客户端)
# PG_PSQL=C:\Program Files\PostgreSQL\18\bin\psql.exe
# PG_HOST=127.0.0.1
# PG_PORT=5432
# PG_USER=BIuser
# PG_DB=BusinessIntelligence
# PG_PASSWORD=改成实际密码
